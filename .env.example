# Firebase (Realtime Database verbenastenerife, europe-west1).
# NO commitear el .env real (está en .gitignore). Este fichero es plantilla.
# Service account: Console Firebase -> Configuración -> Cuentas de
# servicio -> Generar clave JSON. Vale ruta a fichero o JSON inline.
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"verbenastenerife"}

# Config pública (SDK web). La apiKey es pública por diseño de Firebase,
# pero vive en .env y no hardcodeada; ponle restricciones HTTP en Console.
PUBLIC_FIREBASE_API_KEY=tu_api_key
PUBLIC_FIREBASE_AUTH_DOMAIN=verbenastenerife.firebaseapp.com
PUBLIC_FIREBASE_DATABASE_URL=https://verbenastenerife-default-rtdb.europe-west1.firebasedatabase.app
PUBLIC_FIREBASE_PROJECT_ID=verbenastenerife
PUBLIC_FIREBASE_STORAGE_BUCKET=verbenastenerife.firebasestorage.app
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
PUBLIC_FIREBASE_APP_ID=tu_app_id
PUBLIC_FIREBASE_MEASUREMENT_ID=tu_measurement_id

# IA para verificar vigencia de hallazgos (cadena: Gemini -> Groq ->
# OpenRouter -> Pollinations sin clave; con fallback a regex si todo falla).
# Claves gratis, sin tarjeta: https://aistudio.google.com/apikey ,
# https://console.groq.com , https://openrouter.ai
# Tu volumen (4-5 consultas/día) cabe en todos los niveles gratuitos.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
OPENROUTER_API_KEY=
# DeepSeek (PAGO, hilar fino): solo se usa si IA_PAGO=1, y aun así el ÚLTIMO
# de la cadena (solo gasta si todo lo gratis falló). Cap por revisión.
DEEPSEEK_API_KEY=
IA_PAGO=0
MAX_IA_POSTS=120
