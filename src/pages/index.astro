---
export const prerender = false;
import { FUENTES } from '../lib/verbenas.js';
import { COORDS } from '../lib/coords.js';

// Shell instantánea estilo DeBelingo: fondo oscuro, cabecera azul→púrpura,
// días en amarillo, tarjetas con bordes laterales por tipo.
// Los datos llegan en vivo por municipio (barra de progreso + chips).
// La meteo se pide por MUNICIPIO (lagenda trae muchos en una fuente).
const filtro = Astro.url.searchParams.get('municipio') || undefined;
const fuentes = (filtro
  ? FUENTES.filter((f) => f.id === filtro.toLowerCase())
  : FUENTES
).map((f) => ({ id: f.id, nombre: f.nombre }));
// Config Firebase web (solo pública) para lectura directa de RTDB.
// Sin DATABASE_URL se usa la API en vivo (que además rellena la BD).
const fbConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY || '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN || '',
  databaseURL: import.meta.env.PUBLIC_FIREBASE_DATABASE_URL || '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || '',
  storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET || '',
  messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID || '',
  appId: import.meta.env.PUBLIC_FIREBASE_APP_ID || ''
};
const fbOn = !!(fbConfig.apiKey && fbConfig.databaseURL);
---

<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Verbenas Tenerife — Próximas Verbenas</title>
  <script type="importmap">
    { "imports": {
      "html2canvas": "https://esm.sh/html2canvas@1.4.1",
      "firebase/app": "https://esm.sh/firebase@12.19.0/app",
      "firebase/database": "https://esm.sh/firebase@12.19.0/database"
    } }
  </script>
  <!-- is:global: las tarjetas se inyectan por JS sin el atributo de scope
    de Astro; con estilo encapsulado quedarían sin CSS (iconos gigantes). -->
  <style is:global>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #111827; color: #fff; }
    a { color: #93c5fd; }
    /* Cabecera */
    .cabecera { position: relative; background: #2563eb; padding: 12px 8px 8px; text-align: center; }
    @media (min-width: 768px) { .cabecera { background: linear-gradient(to right, #2563eb, #9333ea); } }
    .cabecera h1 { margin: 0; font-size: 1.25rem; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 8px; }
    @media (min-width: 768px) { .cabecera h1 { font-size: 1.875rem; } }
    .cabecera h1 svg { width: 20px; height: 20px; }
    .badges { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 4px; flex-wrap: wrap; }
    .badge-update { display: flex; align-items: center; gap: 6px; background: rgba(30,58,138,.4); padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; color: #dbeafe; white-space: nowrap; }
    .badge-fuente { background: rgba(31,41,55,.4); padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 800; color: #9ca3af; white-space: nowrap; }
    .badge-fuente.ok { color: #6ee7b7; } .badge-fuente.error { color: #fca5a5; }
    /* Progreso */
    .progreso { max-width: 860px; margin: 12px auto 0; padding: 0 24px; }
    .barra-ext { background: #374151; border-radius: 999px; height: 10px; overflow: hidden; margin: 6px 0; }
    .barra-int { background: linear-gradient(to right, #3b82f6, #a855f7); height: 100%; width: 0%; transition: width .3s; }
    .chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; justify-content: center; }
    .chip { border-radius: 999px; padding: 2px 10px; font-size: 12px; background: #1f2937; color: #9ca3af; border: 1px solid #374151; }
    .chip.ok { background: rgba(6,78,59,.5); color: #6ee7b7; border-color: rgba(16,185,129,.3); }
    .chip.error { background: rgba(127,29,29,.5); color: #fca5a5; border-color: rgba(239,68,68,.3); }
    #progreso-texto { text-align: center; color: #9ca3af; font-size: 13px; }
    /* Navegación municipios */
    .nav-muni { text-align: center; padding: 10px; font-size: 14px; }
    .nav-muni a { margin: 0 8px; color: #93c5fd; text-decoration: none; }
    .nav-muni a.activo { color: #fff; font-weight: 800; text-decoration: underline; }
    /* Días */
    .lista { padding: 0 24px 24px; max-width: 860px; margin: 0 auto; }
    .dia { border-top: 1px solid rgba(55,65,81,.3); }
    .dia:first-child { border-top: none; }
    .dia-titulo { margin: 12px 0; padding: 12px 0; text-align: center;
      background: linear-gradient(to right, transparent, rgba(250,204,21,.1), transparent); }
    .dia-titulo h3 { margin: 0; color: #facc15; font-size: 1.25rem; font-weight: 800; letter-spacing: .05em;
      text-transform: uppercase; display: flex; align-items: center; justify-content: center; gap: 12px; }
    .dia-titulo svg { width: 22px; height: 22px; opacity: .7; }
    /* Tarjeta */
    .card { position: relative; overflow: hidden; padding: 12px 16px; margin-bottom: 8px;
      border: 1px solid rgba(55,65,81,.5); border-left-width: 4px; border-right-width: 4px; cursor: pointer; }
    .card:hover { filter: brightness(1.1); }
    .card .fila { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px 16px; text-align: center; }
    .hora { font-family: ui-monospace, monospace; font-weight: 800; font-size: 1.35rem; color: #fff; }
    .hora small { font-size: 12px; color: #9ca3af; font-weight: 400; }
    .meteo { display: inline-flex; align-items: center; gap: 4px; font-size: 15px; color: #bfdbfe;
      background: rgba(30,58,138,.35); border: 1px solid rgba(59,130,246,.25); border-radius: 6px; padding: 2px 8px; }
    .tipo-badge { padding: 4px 10px; background: rgba(6,182,212,.15); color: #67e8f9;
      border-radius: 4px; font-size: 16px; border: 1px solid rgba(6,182,212,.2); }
    .lugar { display: flex; align-items: center; gap: 6px; color: #d1d5db; font-size: 18px; }
    .lugar svg { width: 20px; height: 20px; color: #6b7280; flex-shrink: 0; }
    .orquestas { display: flex; align-items: center; gap: 8px; color: #4ade80; font-weight: 600; font-size: 18px; }
    .orquestas svg { width: 20px; height: 20px; opacity: .6; flex-shrink: 0; }
    .titulo { flex-basis: 100%; color: #fff; font-weight: 700; font-size: 17px; line-height: 1.35; }
    .chev { background: none; border: none; color: #6b7280; cursor: pointer; padding: 4px; }
    .chev svg { width: 16px; height: 16px; transition: transform .3s; }
    .chev.abierto svg { transform: rotate(180deg); }
    .detalle { display: none; margin-top: 16px; padding-top: 16px; border-top: 1px solid rgba(75,85,99,.5); }
    .detalle.abierto { display: block; }
    .detalle-box { background: rgba(0,0,0,.2); padding: 16px; border-radius: 8px; }
    .detalle-box h4 { margin: 0 0 12px; color: #93c5fd; font-size: 14px; text-transform: uppercase; letter-spacing: .05em; }
    .btns { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; margin-top: 8px; border-top: 1px solid rgba(55,65,81,.5); }
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 8px 16px; border-radius: 8px;
      font-size: 14px; font-weight: 500; text-decoration: none; border: 1px solid; }
    .btn-titsa { background: rgba(20,83,45,.5); color: #6ee7b7; border-color: rgba(16,185,129,.3); }
    .btn-llegar { background: rgba(6,78,59,.5); color: #6ee7b7; border-color: rgba(16,185,129,.3); }
    .btn-fuente { background: rgba(30,58,138,.5); color: #bfdbfe; border-color: rgba(59,130,246,.3); }
    .motivos { color: #9ca3af; font-size: 12px; margin-top: 8px; }
    /* Leyenda + pie */
    .leyenda { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px;
      font-size: 10px; color: #6b7280; padding: 0 24px 16px; max-width: 860px; margin: 0 auto; }
    .leyenda i { display: inline-block; width: 12px; height: 3px; border-radius: 999px; margin-right: 4px; vertical-align: middle; }
    .pie { background: linear-gradient(to right, #1f2937, #374151); padding: 24px; text-align: center;
      color: #f59e0b; font-weight: 700; font-size: 14px; }
    .pie small { display: block; color: #9ca3af; font-weight: 400; margin-top: 4px; }
    .vacio { text-align: center; color: #9ca3af; padding: 40px 0; }
    .btn-agenda { background: linear-gradient(to right, #3b82f6, #a855f7); color: #fff; border: none;
      border-radius: 8px; padding: 8px 18px; font-size: 14px; font-weight: 700; cursor: pointer; }
    .modal { position: fixed; inset: 0; background: rgba(0,0,0,.85); z-index: 100;
      display: flex; align-items: center; justify-content: center; padding: 16px; }
    .modal-box { background: #1f2937; border-radius: 12px; padding: 16px; max-width: 560px; width: 100%;
      max-height: 90vh; overflow: auto; text-align: center; }
    .modal-box h3 { margin: 0 0 12px; }
    .modal-box img { max-width: 100%; border-radius: 8px; background: #111827; }
    .bd { max-width: 900px; margin: 28px auto 40px; padding: 0 16px; }
    .bd h3 { text-align: center; color: #9ca3af; font-size: 16px; margin: 0 0 12px; }
    .bd small { display: block; text-align: center; color: #9ca3af; margin-top: 8px; }
    .tabla-ext { overflow-x: auto; }
    .bd table { width: 100%; border-collapse: collapse; font-size: 13px; }
    .bd th, .bd td { padding: 6px 10px; border-bottom: 1px solid #374151; text-align: left; }
    .bd th { color: #9ca3af; font-weight: 600; }
    .bd td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .bd .ok { color: #4ade80; } .bd .mal { color: #f87171; }
    .bd-dia { margin: 14px 0 6px; color: #facc15; font-size: 14px; font-weight: 800;
      text-transform: uppercase; letter-spacing: .05em; text-align: center; }
    .bd-item { background: #1f2937; border: 1px solid #374151; border-radius: 8px;
      padding: 8px 12px; margin-bottom: 6px; font-size: 14px; }
    .bd-item .fh { font-family: ui-monospace, monospace; font-weight: 800; }
    .bd-item .lug { color: #9ca3af; }
    .bd-item .orq { color: #4ade80; }
    .bd-item s { color: #6b7280; }
    .bd-fuente { display: inline-block; font-size: 11px; background: rgba(30,58,138,.5);
      color: #bfdbfe; border-radius: 999px; padding: 1px 8px; margin-left: 6px; }
    .bd-fuente.fb { background: rgba(6,78,59,.5); color: #6ee7b7; }
    .bd-fb-item { border-left: 3px solid #6ee7b7; }
    .bd-fb-item .txt { color: #e5e7eb; font-size: 13px; margin: 4px 0; }
    .bd .muted { color: #6b7280; }
  </style>
</head>
<body>
  <header class="cabecera">
    <h1>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
      Próximas Verbenas
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>
    </h1>
    <div class="badges">
      <span class="badge-update">🕐 ACTUALIZADO: <span id="badge-hoy">…</span></span>
      <span class="badge-fuente" id="badge-fuentes">⏳ conectando…</span>
    </div>
  </header>

  <nav class="nav-muni" id="nav-muni"></nav>
  <div style="text-align:center;font-size:13px;margin-top:4px">
    <a href="/cuentas" style="color:#6b7280">📘 Gestionar cuentas Facebook a vigilar</a> ·
    <a href="/candidatas" style="color:#6b7280">🔎 Candidatas de Facebook</a>
  </div>

  <div style="text-align:center;margin:4px 0 0">
    <button id="btn-agenda" class="btn-agenda">📥 Exportar agenda (semana)</button>
  </div>

  <div id="modal-agenda" class="modal" style="display:none">
    <div class="modal-box">
      <h3>Agenda de la semana</h3>
      <img id="img-agenda" alt="Agenda exportada" />
      <div class="btns" style="justify-content:center">
        <button id="btn-compartir" class="btn btn-fuente">📤 Compartir</button>
        <button id="btn-descargar" class="btn btn-llegar">⬇️ Descargar</button>
        <button id="btn-cerrar" class="btn">Cerrar</button>
      </div>
    </div>
  </div>

  <section class="progreso">
    <div id="progreso-texto">Preparando…</div>
    <div class="barra-ext"><div class="barra-int" id="progreso-barra"></div></div>
    <div class="chips" id="progreso-chips"></div>
  </section>

  <main class="lista" id="lista"></main>

  <div class="leyenda" id="leyenda"></div>

  <footer class="pie">
    <div>Última actualización: <span id="pie-hoy">…</span></div>
    <small>VerbenasTenerife · datos en vivo de los ayuntamientos · <span id="pie-total">0</span> verbenas</small>
  </footer>

  <section class="bd" id="bd" hidden>
    <h3>🗄️ En la base de datos</h3>
    <p class="muted" id="bd-resumen" style="text-align:center"></p>
    <div id="bd-lista"></div>
    <div id="bd-fb"></div>
    <small>La base de datos solo guarda hoy y futuro; lo pasado se borra automáticamente.</small>
  </section>

  <noscript><p style="text-align:center">Necesitas JavaScript para cargar las agendas en vivo.</p></noscript>

  <script define:vars={{ fuentes, coords: COORDS, fbConfig, fbOn }}>
    // Paleta por tipo (réplica DeBelingo; Concierto/Fiestas propios)
    const TIPO = {
      'Baile Normal':  { b: '#60a5fa', g: 'rgba(96,165,250,0.15)' },
      'Baile Magos':   { b: '#a855f7', g: 'rgba(168,85,247,0.15)' },
      'Romería':       { b: '#f59e0b', g: 'rgba(245,158,11,0.15)' },
      'Inclusiva':     { b: '#2dd4bf', g: 'rgba(45,212,191,0.15)' },
      'Concierto':     { b: '#e879f9', g: 'rgba(232,121,249,0.15)' },
      'Fiestas':       { b: '#fbbf24', g: 'rgba(251,191,36,0.15)' },
      'Romería Chica': { b: '#fbbf24', g: 'rgba(251,191,36,0.15)' },
      'Carnaval':      { b: '#e879f9', g: 'rgba(232,121,249,0.15)' }
    };
    const porDefecto = { b: '#9ca3af', g: 'rgba(156,163,175,0.15)' };
    const DIAS = ['DOMINGO', 'LUNES', 'MARTES', 'MIÉRCOLES', 'JUEVES', 'VIERNES', 'SÁBADO'];
    const MESES = ['ENERO', 'FEBRERO', 'MARZO', 'ABRIL', 'MAYO', 'JUNIO', 'JULIO', 'AGOSTO', 'SEPTIEMBRE', 'OCTUBRE', 'NOVIEMBRE', 'DICIEMBRE'];

    const $ = (id) => document.getElementById(id);
    const texto = $('progreso-texto'), barra = $('progreso-barra'), chipsBox = $('progreso-chips');
    const lista = $('lista'), leyenda = $('leyenda');

    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    const svgPin = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>';
    const svgMus = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>';
    const svgCal = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>';
    const svgChev = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>';

    const total = fuentes.length;
    const todas = [];
    let hechas = 0;
    const chips = {};
    let grupoAbierto = null;

    // Nav municipios
    const params = new URLSearchParams(location.search);
    const fActual = params.get('municipio');
    $('nav-muni').innerHTML = `<a href="/" class="${!fActual ? 'activo' : ''}">Todas</a>` +
      fuentes.map((f) => `<a href="/?municipio=${f.id}" class="${fActual === f.id ? 'activo' : ''}">${esc(f.nombre)}</a>`).join('');

    fuentes.forEach((f) => {
      const el = document.createElement('span');
      el.className = 'chip';
      el.textContent = `⏳ ${f.nombre}`;
      chipsBox.appendChild(el);
      chips[f.id] = el;
    });

    const aFecha = (day) => {
      const [d, m, y] = String(day || '').split('-').map(Number);
      return new Date(Date.UTC(y || 9999, (m || 1) - 1, d || 1));
    };
    const nombreDia = (day) => {
      if (!day) return 'FECHA POR CONFIRMAR';
      const f = aFecha(day);
      return `${DIAS[f.getUTCDay()]} ${String(f.getUTCDate()).padStart(2, '0')} DE ${MESES[f.getUTCMonth()]}`;
    };
    // Orden de más próximo a más antiguo (ascendente por fecha y hora).
    const ordFut = (a, b) => (aFecha(a.day) - aFecha(b.day)) || String(a.hora).localeCompare(String(b.hora));

    const mapsUrl = (v, mode) => {
      const addr = v.lugar ? `${v.lugar}, ${v.municipio}, Tenerife` : `${v.municipio}, Tenerife`;
      return `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(addr)}&travelmode=${mode}`;
    };

    // Meteo Open-Meteo (gratis, sin clave): 1 petición por MUNICIPIO con el
    // rango de sus días futuros (una fuente como lagenda trae muchos).
    // La AEMET vendrá cuando exista su clave en Vercel.
    const meteo = {};
    const normMuni = (s) => String(s || '').toLowerCase().normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, '');
    const dmyAiso = (day) => { const [d, m, y] = String(day).split('-'); return `${y}-${m}-${d}`; };
    const isoAdmy = (iso) => { const [y, m, d] = String(iso).split('-'); return `${d}-${m}-${y}`; };
    const iconoMeteo = (code) => code === 0 ? '☀' : code === 1 ? '🌤️' : code === 2 ? '⛅'
      : code === 3 ? '☁️' : [45, 48].includes(code) ? '🌫️' : [51, 53, 55].includes(code) ? '🌦️'
      : [61, 63, 65, 80, 81, 82].includes(code) ? '🌧️' : [71, 73, 75, 77, 85, 86].includes(code) ? '🌨️'
      : [95, 96, 99].includes(code) ? '⛈️' : '🌤️';

    // Sin coords fijas: geocodifica una vez (Open-Meteo, gratis, sin clave).
    const geoCache = {};
    async function coordsPara(municipio) {
      const c = coords[normMuni(municipio)];
      if (c) return c;
      if (geoCache[municipio] !== undefined) return geoCache[municipio];
      try {
        const r = await fetch(`https://geocoding-api.open-meteo.com/v1/search?name=${encodeURIComponent(municipio + ', Tenerife, España')}&count=1&language=es&format=json`);
        const j = await r.json();
        const g = j.results?.[0];
        geoCache[municipio] = g ? { lat: g.latitude, lon: g.longitude } : null;
      } catch (e) { geoCache[municipio] = null; }
      return geoCache[municipio];
    }

    async function cargaMeteo(municipio, dias) {
      if (!dias.length) return;
      const c = await coordsPara(municipio);
      if (!c) return;
      const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
      const isos = [...new Set(dias.map(dmyAiso))].filter((iso) => {
        const diff = Math.round((new Date(iso + 'T00:00:00') - hoy) / 864e5);
        return diff >= 0 && diff <= 16;
      }).sort();
      if (!isos.length) return;
      try {
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${c.lat}&longitude=${c.lon}&daily=weathercode,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=Atlantic%2FCanary&start_date=${isos[0]}&end_date=${isos[isos.length - 1]}`;
        const r = await fetch(url);
        const j = await r.json();
        (j.daily?.time || []).forEach((t, i) => {
          meteo[`${municipio}|${isoAdmy(t)}`] = {
            tmax: Math.round(j.daily.temperature_2m_max[i]),
            tmin: Math.round(j.daily.temperature_2m_min[i]),
            code: j.daily.weathercode[i],
            prec: j.daily.precipitation_probability_max?.[i]
          };
        });
        render();
      } catch (e) { /* sin meteo: la tarjeta sale igual */ }
    }

    const meteoDe = (v) => meteo[`${v.municipio}|${v.day}`];

    const tarjeta = (v) => {
      const t = TIPO[v.tipo] || porDefecto;
      const orq = (v.orquestas || []).join(' + ');
      const m = meteoDe(v);
      const spanMeteo = m
        ? `<span class="meteo" title="Máx ${m.tmax}° / mín ${m.tmin}°${m.prec != null ? ` · lluvia ${m.prec}%` : ''}">${iconoMeteo(m.code)} ${m.tmax}°/${m.tmin}°</span>`
        : '';
      const abierta = grupoAbierto === v.id ? ' abierto' : '';
      const mostrada = grupoAbierto === v.id ? 'abierto' : '';
      return `
      <article class="card" data-id="${esc(v.id)}"
        style="background:linear-gradient(to right, ${t.g}, transparent 50%, ${t.g});border-left-color:${t.b};border-right-color:${t.b}">
        <div class="fila">
          <div class="hora">${esc(v.hora)} <small>H</small></div>
          ${spanMeteo}
          ${v.tipo && v.tipo !== 'Baile Normal' ? `<div class="tipo-badge">${esc(v.tipo)}</div>` : ''}
          <div class="lugar">${svgPin}<span>${esc(v.lugar ? v.lugar + ', ' : '')}${esc(v.municipio)}</span></div>
          <button class="chev${abierta}" data-chev="${esc(v.id)}" aria-label="Ver detalles">${svgChev}</button>
          <div class="titulo">${esc(v.titulo)}</div>
          ${orq ? `<div class="orquestas">${svgMus}<span>${esc(orq)}</span></div>` : ''}
        </div>
        <div class="detalle ${mostrada}" data-det="${esc(v.id)}">
          <div class="detalle-box">
            <h4>Información del evento</h4>
            <div class="btns">
              <a class="btn btn-llegar" target="_blank" rel="noopener" href="${mapsUrl(v, 'driving')}">🚗 Cómo llegar</a>
              <a class="btn btn-titsa" target="_blank" rel="noopener" href="${mapsUrl(v, 'transit')}">🚌 TITSA</a>
              <a class="btn btn-fuente" target="_blank" rel="noopener" href="${esc(v.url)}">🔗 Fuente oficial</a>
            </div>
            ${(v.motivos || []).length ? `<p class="motivos">Detectada por: ${esc(v.motivos.join(' · '))} (score ${v.score ?? ''})</p>` : ''}
          </div>
        </div>
      </article>`;
    };

    function render() {
      const fut = todas.filter((v) => v.futura).sort(ordFut);
      // Agrupa por día de más próximo a más antiguo. Las ya celebradas
      // no se muestran (siguen disponibles en la API con ?filtro=pasadas).
      const grupos = {};
      fut.forEach((v) => { (grupos[v.day || ''] = grupos[v.day || ''] || []).push(v); });
      const dias = Object.keys(grupos).sort((x, y) => (aFecha(x) - aFecha(y)) || x.localeCompare(y));
      lista.innerHTML = dias.map((day) => `
        <section class="dia">
          <div class="dia-titulo"><h3>${svgCal}<span>${esc(nombreDia(day))}</span>${svgCal}</h3></div>
          ${grupos[day].map(tarjeta).join('')}
        </section>`).join('') || '<p class="vacio">Sin verbenas próximas en los municipios cargados.</p>';
      // Leyenda de tipos activos
      const tipos = [...new Set(todas.map((v) => v.tipo).filter(Boolean))];
      leyenda.innerHTML = tipos.map((tipo) => {
        const t = TIPO[tipo] || porDefecto;
        return `<span><i style="background:${t.b}"></i>${esc(tipo)}</span>`;
      }).join('');
      $('pie-total').textContent = todas.length;
    }

    lista.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-chev]');
      const card = e.target.closest('.card');
      const id = btn ? btn.dataset.chev : (card ? card.dataset.id : null);
      if (!id) return;
      grupoAbierto = grupoAbierto === id ? null : id;
      document.querySelectorAll(`[data-det="${CSS.escape(id)}"]`).forEach((d) => d.classList.toggle('abierto', grupoAbierto === id));
      document.querySelectorAll(`[data-chev="${CSS.escape(id)}"]`).forEach((b) => b.classList.toggle('abierto', grupoAbierto === id));
    });

    function avanza() {
      hechas++;
      barra.style.width = `${Math.round((hechas / total) * 100)}%`;
      if (hechas >= total) {
        const n = todas.filter((v) => v.futura).length;
        texto.textContent = `Listo: ${hechas}/${total} municipios · ${n} próximas.`;
        const bf = $('badge-fuentes');
        bf.textContent = `✓ ${hechas}/${total} municipios`;
        bf.classList.add('ok');
      }
    }

    async function cargaFuente(f) {
      texto.textContent = `Cargando ${f.nombre}… (${hechas + 1}/${total})`;
      try {
        const r = await fetch(`/api/verbenas.json?municipio=${f.id}&filtro=todas`);
        if (!r.ok) throw new Error(`HTTP ${r.status}`);
        const d = await r.json();
        if (d.hoy) { $('badge-hoy').textContent = d.hoy; $('pie-hoy').textContent = d.hoy; }
        todas.push(...(d.verbenas || []));
        const nFut = (d.verbenas || []).filter((v) => v.futura).length;
        chips[f.id].className = 'chip ok';
        chips[f.id].textContent = `✓ ${f.nombre} (${nFut})`;
        const porMuni = {};
        (d.verbenas || []).filter((v) => v.futura).forEach((v) => {
          (porMuni[v.municipio] = porMuni[v.municipio] || []).push(v.day);
        });
        Object.entries(porMuni).forEach(([muni, dias]) => cargaMeteo(muni, dias));
      } catch (err) {
        chips[f.id].className = 'chip error';
        chips[f.id].textContent = `✗ ${f.nombre} (falló)`;
      }
      avanza();
      render();
    }

    async function main() {
      // Vía base de datos (una lectura); si falla o está vacía, en vivo.
      if (fbOn) {
        try { await cargaDesdeBD(); return; }
        catch (e) { console.warn('BD no disponible, en vivo:', e?.message || e); }
      }
      await cargaEnVivo();
    }

    const haceX = (ts) => {
      if (!ts) return '—';
      const h = Math.floor((Date.now() - ts) / 36e5);
      if (h < 1) return 'hace minutos';
      if (h < 24) return `hace ${h} h`;
      const d = Math.floor(h / 24);
      return d === 1 ? 'ayer' : `hace ${d} días`;
    };

    async function cargaDesdeBD() {
      const [{ initializeApp }, { getDatabase, ref, get }] = await Promise.all([
        import('firebase/app'), import('firebase/database')
      ]);
      const db = getDatabase(initializeApp(fbConfig));
      const [ev, me, fb] = await Promise.all([
        get(ref(db, 'events')), get(ref(db, 'meta')), get(ref(db, 'fb_candidatos')).catch(() => null)
      ]);
      const datos = ev.val() || null;
      if (!datos || !Object.keys(datos).length) throw new Error('BD vacía');
      const meta = me.val() || {};
      const fbDatos = (fb && fb.val()) || {};
      // Dedup por ID (patrón admin): el vivo gana si hubiera solape.
      const mapa = new Map();
      Object.entries(datos).forEach(([id, v]) => mapa.set(id, { id, ...v }));
      let lista = [...mapa.values()];
      if (fActual) lista = lista.filter((v) => v.fuente === fActual);
      const hoy0 = new Date(); hoy0.setHours(0, 0, 0, 0);
      lista.forEach((v) => { v.futura = aFecha(v.day) >= hoy0; });
      todas.push(...lista);
      const hoyTxt = `${String(hoy0.getDate()).padStart(2, '0')}-${String(hoy0.getMonth() + 1).padStart(2, '0')}-${hoy0.getFullYear()}`;
      $('badge-hoy').textContent = hoyTxt; $('pie-hoy').textContent = hoyTxt;
      for (const f of fuentes) {
        const evs = lista.filter((v) => v.fuente === f.id);
        const nFut = evs.filter((v) => v.futura).length;
        const m = meta[f.id];
        chips[f.id].className = 'chip ok';
        chips[f.id].textContent = `✓ ${f.nombre} (${nFut})${m?.at ? ` · ${haceX(m.at)}` : ''}${m && m.ok === false ? ' ⚠' : ''}`;
        const porMuni = {};
        evs.filter((v) => v.futura).forEach((v) => {
          (porMuni[v.municipio] = porMuni[v.municipio] || []).push(v.day);
        });
        Object.entries(porMuni).forEach(([muni, dias]) => cargaMeteo(muni, dias));
      }
      hechas = total;
      barra.style.width = '100%';
      texto.textContent = `Listo: ${total}/${total} municipios · ${todas.filter((v) => v.futura).length} próximas (base de datos).`;
      const bf = $('badge-fuentes');
      bf.textContent = `✓ ${total}/${total} municipios (BD)`;
      bf.classList.add('ok');
      render();
      const fbLista = Object.values(fbDatos)
        .filter((c) => ((c.dias ?? 999) <= 7))
        .sort((a, b) => (b.score || 0) - (a.score || 0));
      renderBD(meta, mapa.size, fbLista);
    }

    // Listado cronológico de TODO lo guardado (ayuntamientos + Facebook),
    // ordenado por hora, no por fuente. Node escribe sus hallazgos de FB en
    // `fb_candidatos` y aparecen aquí debajo de los eventos con fecha.
    function renderBD(meta, guardados, fbLista) {
      const nombreFuente = (id) => (fuentes.find((f) => f.id === id) || {}).nombre || id;
      // Eventos con fecha, de más próximos a más antiguos (solo futuras:
      // las pasadas se obvian, siguen en la API con ?filtro=pasadas).
      const evs = [...todas].filter((v) => v.futura).sort(ordFut);
      const grupos = {};
      evs.forEach((v) => { (grupos[v.day || ''] = grupos[v.day || ''] || []).push(v); });
      const dias = Object.keys(grupos).sort((x, y) => (aFecha(x) - aFecha(y)) || x.localeCompare(y));
      $('bd-lista').innerHTML = dias.map((day) =>
        `<div class="bd-dia">${esc(nombreDia(day))}</div>` +
        grupos[day].map((v) => {
          const orq = (v.orquestas || []).join(' + ');
          const cuerpo = `<span class="fh">${esc(v.hora || '--:--')}</span> ` +
            `<strong>${esc(v.titulo)}</strong>` +
            `<span class="lug"> · ${esc(v.lugar ? v.lugar + ', ' : '')}${esc(v.municipio)}</span>` +
            (orq ? ` <span class="orq">🎵 ${esc(orq)}</span>` : '') +
            `<span class="bd-fuente">${esc(nombreFuente(v.fuente))}</span>`;
          return `<div class="bd-item">${cuerpo}</div>`;
        }).join('')
      ).join('') || '<p class="vacio">Sin eventos guardados.</p>';
      // Hallazgos de Facebook (sin fecha exacta del evento): por score
      $('bd-fb').innerHTML = (fbLista && fbLista.length)
        ? `<div class="bd-dia">📘 Hallazgos de Facebook (${fbLista.length})</div>` +
          fbLista.map((c) =>
            `<div class="bd-item bd-fb-item"><strong>${esc(c.cuenta || '')}</strong>` +
            ` <span class="lug">${esc(c.fecha || 's/f')} · score ${c.score ?? ''}</span>` +
            `<span class="bd-fuente fb">Facebook</span>` +
            `<p class="txt">${esc((c.texto || '').slice(0, 300))}</p>` +
            `${(c.pdfs || []).map((p) => `<a href="${esc(p)}" target="_blank" rel="noopener">📄 PDF</a>`).join(' ')}` +
            `${c.url ? ` <a href="${esc(c.url)}" target="_blank" rel="noopener">🔗 post</a>` : ''}</div>`
          ).join('')
        : '';
      $('bd-resumen').textContent =
        `${guardados} eventos de ayuntamientos` +
        ((fbLista && fbLista.length) ? ` + ${fbLista.length} hallazgos de Facebook` : '') +
        ` · ${todas.filter((v) => v.futura).length} próximos en total.`;
      $('bd').hidden = false;
    }

    async function cargaEnVivo() {
      if (!total) {
        texto.textContent = 'Municipio desconocido.';
        return;
      }
      texto.textContent = `Cargando 0/${total} municipios…`;
      render();
      const pendientes = [...fuentes];
      const workers = Array.from(
        { length: Math.min(4, pendientes.length) },
        async () => { while (pendientes.length) await cargaFuente(pendientes.shift()); }
      );
      await Promise.all(workers);
    }

    // ---- Exportar agenda (modo DeBelingo, adaptado: semana ayer→domingo) ----
    const aMedianoche = (d) => { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; };
    const parseDMY = (day) => {
      const [d, m, y] = String(day || '').split('-').map(Number);
      return d && m && y ? new Date(y, m - 1, d) : null;
    };
    function semanaAgenda() {
      const hoy = aMedianoche(new Date());
      const inicio = new Date(hoy); inicio.setDate(hoy.getDate() - 1); // ayer
      const fin = new Date(hoy);
      fin.setDate(hoy.getDate() + (hoy.getDay() === 0 ? 0 : 7 - hoy.getDay())); // domingo
      fin.setHours(23, 59, 59, 999);
      return todas.filter((v) => {
        const f = parseDMY(v.day);
        return f && f >= inicio && f <= fin;
      }).sort((a, b) => (aFecha(a.day) - aFecha(b.day)) || String(a.hora).localeCompare(String(b.hora)));
    }
    function nodoAgenda(evs) {
      const dias = {};
      evs.forEach((v) => { (dias[v.day] = dias[v.day] || []).push(v); });
      const el = document.createElement('div');
      el.style.cssText = 'width:1000px;background:#111827;color:#fff;font-family:system-ui,sans-serif;padding:32px';
      el.innerHTML = `<h1 style="text-align:center;font-size:34px;margin:0 0 4px">🎵 Verbenas Tenerife</h1>
        <p style="text-align:center;color:#9ca3af;margin:0 0 20px">Agenda de la semana · verbenastenerife</p>` +
        Object.keys(dias).sort().map((day) => `
          <h2 style="color:#facc15;text-align:center;text-transform:uppercase;letter-spacing:2px;font-size:22px;margin:22px 0 10px">${esc(nombreDia(day))}</h2>` +
          dias[day].map((v) => {
            const t = TIPO[v.tipo] || porDefecto;
            const orq = (v.orquestas || []).join(' + ');
            return `<div style="border-left:6px solid ${t.b};background:#1f2937;border-radius:8px;padding:12px 16px;margin:0 0 8px">
              <div style="font-size:26px;font-weight:800">${esc(v.hora)} <small style="font-size:13px;color:#9ca3af">H</small>
                <span style="font-size:15px;color:#d1d5db;font-weight:400"> · ${esc(v.lugar ? v.lugar + ', ' : '')}${esc(v.municipio)}</span></div>
              <div style="font-size:17px;font-weight:700;margin-top:2px">${esc(v.titulo)}</div>
              ${orq ? `<div style="color:#4ade80;font-size:17px">🎵 ${esc(orq)}</div>` : ''}
              ${v.tipo && v.tipo !== 'Baile Normal' ? `<span style="display:inline-block;margin-top:4px;background:rgba(6,182,212,.15);color:#67e8f9;border-radius:4px;padding:2px 8px;font-size:14px">${esc(v.tipo)}</span>` : ''}
            </div>`;
          }).join('')).join('');
      return el;
    }
    const limiteExport = () => {
      try {
        const k = 'vt_export_hist';
        const ahora = Date.now(), h = 36e5;
        let ts = JSON.parse(localStorage.getItem(k) || '[]').filter((t) => ahora - t < h);
        if (ts.length >= 50) return false;
        ts.push(ahora);
        localStorage.setItem(k, JSON.stringify(ts));
        return true;
      } catch (e) { return true; }
    };
    let pngAgenda = null;
    $('btn-agenda').addEventListener('click', async () => {
      const evs = semanaAgenda();
      if (!evs.length) { alert('No hay verbenas esta semana para exportar.'); return; }
      if (!limiteExport()) { alert('Límite de 50 exportaciones por hora.'); return; }
      $('btn-agenda').textContent = '⏳ Generando…';
      try {
        const nodo = nodoAgenda(evs);
        nodo.style.position = 'fixed';
        nodo.style.left = '-1200px';
        document.body.appendChild(nodo);
        const { default: html2canvas } = await import('html2canvas');
        const canvas = await html2canvas(nodo, { backgroundColor: '#111827', scale: 2 });
        document.body.removeChild(nodo);
        pngAgenda = canvas.toDataURL('image/png');
        $('img-agenda').src = pngAgenda;
        $('modal-agenda').style.display = 'flex';
      } catch (e) {
        console.error(e);
        alert('No se pudo generar la imagen.');
      }
      $('btn-agenda').textContent = '📥 Exportar agenda (semana)';
    });
    $('btn-cerrar').addEventListener('click', () => { $('modal-agenda').style.display = 'none'; });
    $('btn-descargar').addEventListener('click', () => {
      if (!pngAgenda) return;
      const a = document.createElement('a');
      a.href = pngAgenda;
      a.download = 'agenda-verbenas-tenerife.png';
      a.click();
    });
    $('btn-compartir').addEventListener('click', async () => {
      if (!pngAgenda) return;
      try {
        const blob = await (await fetch(pngAgenda)).blob();
        const file = new File([blob], 'agenda-verbenas.png', { type: 'image/png' });
        if (navigator.canShare && navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: 'Verbenas Tenerife' });
          return;
        }
        throw new Error('sin share de archivos');
      } catch (e) {
        try {
          await navigator.share({ title: 'Verbenas Tenerife', url: location.href });
        } catch (e2) { /* cancelado */ }
      }
    });

    main();
  </script>
</body>
</html>
