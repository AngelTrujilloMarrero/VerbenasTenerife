---
export const prerender = false;
// Config Firebase web (solo pública) para leer fb_candidatos directo:
// en Vercel no hay .cache local ni service account, pero la lectura
// pública sí llega. Si falla o está vacía, se cae a /api/fb-candidatas.
const fbConfig = {
  apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY || '',
  authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN || '',
  databaseURL: import.meta.env.PUBLIC_FIREBASE_DATABASE_URL || '',
  projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID || ''
};
const fbOn = !!(fbConfig.apiKey && fbConfig.databaseURL);
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Candidatas Facebook — Verbenas Tenerife</title>
  <script type="importmap">
    { "imports": {
      "firebase/app": "https://esm.sh/firebase@12.19.0/app",
      "firebase/database": "https://esm.sh/firebase@12.19.0/database"
    } }
  </script>
  <style is:global>
    * { box-sizing: border-box; }
    body { margin: 0; font-family: system-ui, -apple-system, sans-serif; background: #111827; color: #fff; }
    a { color: #93c5fd; }
    .cabecera { background: #2563eb; padding: 12px 8px; text-align: center; }
    @media (min-width: 768px) { .cabecera { background: linear-gradient(to right, #2563eb, #9333ea); } }
    .cabecera h1 { margin: 0; font-size: 1.4rem; font-weight: 800; }
    .cabecera p { margin: 4px 0 0; color: #dbeafe; font-size: 13px; }
    .top-nav { text-align: center; padding: 10px; font-size: 14px; }
    .wrap { max-width: 860px; margin: 0 auto; padding: 0 16px 32px; }
    .busca { width: 100%; background: #1f2937; color: #fff; border: 1px solid #374151; border-radius: 8px; padding: 10px 14px; font-size: 15px; margin: 12px 0; }
    .card { background: #1f2937; border: 1px solid #374151; border-left: 4px solid #a855f7; border-radius: 10px; padding: 14px 16px; margin-bottom: 12px; }
    .card .meta { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; font-size: 13px; color: #9ca3af; margin-bottom: 8px; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px; }
    .score { background: rgba(168,85,247,.2); color: #d8b4fe; font-weight: 800; }
    .motivos { color: #6ee7b7; font-size: 12px; }
    .texto { font-size: 15px; line-height: 1.5; white-space: pre-wrap; }
    .fotos { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .fotos img { width: 140px; height: 100px; object-fit: cover; border-radius: 8px; border: 1px solid #374151; }
    .pdfs { margin-top: 10px; display: flex; gap: 8px; flex-wrap: wrap; }
    .btn-pdf { display: inline-flex; gap: 6px; padding: 8px 14px; border-radius: 8px; font-size: 13px; font-weight: 700; text-decoration: none;
      background: rgba(127,29,29,.5); color: #fca5a5; border: 1px solid rgba(239,68,68,.3); }
    .btn-fb { display: inline-block; margin-top: 10px; font-size: 13px; }
    .muted { color: #9ca3af; font-size: 13px; text-align: center; }
    .vacio { text-align: center; color: #9ca3af; padding: 40px 0; }
  </style>
</head>
<body>
  <header class="cabecera">
    <h1>🔎 Candidatas de Facebook</h1>
    <p id="sub">Listado completo de la base de datos · texto + fotos + PDFs</p>
  </header>
  <nav class="top-nav"><a href="/">← Verbenas</a> · <a href="/cuentas">📘 Cuentas</a></nav>

  <div class="wrap">
    <input class="busca" id="busca" placeholder="Filtrar por texto, cuenta u orquesta…" />
    <p class="muted" id="info">Cargando…</p>
    <main id="lista"></main>
  </div>

  <script define:vars={{ fbConfig, fbOn }}>
    const $ = (id) => document.getElementById(id);
    let todas = [];
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) =>
      ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    function tarjeta(c) {
      const fotos = (c.fotos || []).map((f) =>
        `<a href="${esc(f)}" target="_blank" rel="noopener"><img src="${esc(f)}" loading="lazy" alt="Foto del post" /></a>`).join('');
      const pdfs = (c.pdfs || []).map((p) =>
        `<a class="btn-pdf" href="${esc(p)}" target="_blank" rel="noopener">📄 ${esc(decodeURIComponent(p.split('/').pop().split('?')[0]).slice(0, 40) || 'Ver PDF')}</a>`).join('');
      return `
      <article class="card">
        <div class="meta">
          <strong>${esc(c.cuenta)}</strong>
          <span>${esc(c.fecha || 's/f')}</span>
          ${c.eventoDay ? `<span>📅 evento ${esc(c.eventoDay)}</span>` : ''}
          <span class="badge score">score ${c.score ?? ''}</span>
        </div>
        <div class="motivos">${esc((c.motivos || []).join(' · '))}</div>
        <p class="texto">${esc(c.texto)}</p>
        ${fotos ? `<div class="fotos">${fotos}</div>` : ''}
        ${pdfs ? `<div class="pdfs">${pdfs}</div>` : ''}
        ${c.url ? `<a class="btn-fb" href="${esc(c.url)}" target="_blank" rel="noopener">🔗 Ver post en Facebook</a>` : ''}
      </article>`;
    }

    function render() {
      const q = $('busca').value.toLowerCase().trim();
      const lista = q
        ? todas.filter((c) => ((c.texto || '') + ' ' + (c.cuenta || '') + ' ' + (c.motivos || []).join(' ')).toLowerCase().includes(q))
        : todas;
      $('lista').innerHTML = lista.length
        ? lista.map(tarjeta).join('')
        : '<p class="vacio">Sin candidatas con ese filtro.</p>';
    }

    async function viaBD() {
      const [{ initializeApp }, { getDatabase, ref, get }] = await Promise.all([
        import('firebase/app'), import('firebase/database')
      ]);
      const db = getDatabase(initializeApp(fbConfig), fbConfig.databaseURL);
      const snap = await get(ref(db, 'fb_candidatos'));
      const val = snap.val() || {};
      const lista = Object.values(val)
        .filter((c) => ((c.dias ?? 999) <= 7))
        .sort((a, b) => (b.score || 0) - (a.score || 0));
      if (!lista.length) throw new Error('BD vacía');
      return lista;
    }

    async function viaAPI() {
      const r = await fetch('/api/fb-candidatas');
      const d = await r.json();
      if (!d.ok) throw new Error(d.error || 'fallo');
      return { lista: d.candidatas || [], nota: d };
    }

    async function main() {
      // 1º Firebase directo (funciona en Vercel), 2º API local.
      try {
        if (!fbOn) throw new Error('sin config Firebase');
        todas = await viaBD();
        $('info').textContent = `${todas.length} candidatas · fuente: Firebase`;
        render();
        return;
      } catch (e) {
        console.warn('BD no disponible, vía API:', e?.message || e);
      }
      try {
        const { lista, nota } = await viaAPI();
        todas = lista;
        const fuente = nota.fuente === 'db' ? 'Firebase' : nota.fuente === 'local' ? 'revisión local' : '—';
        $('info').textContent = `${nota.total} candidatas · fuente: ${fuente}` +
          (nota.meta?.at || nota.meta?.actualizadoEl ? ` · actualizado: ${esc(nota.meta.at ? new Date(nota.meta.at).toLocaleString('es-ES') : nota.meta.actualizadoEl)}` : '') +
          (nota.aviso ? ` · ${nota.aviso}` : '');
        render();
      } catch (e) {
        $('info').textContent = 'Error: ' + e.message;
      }
    }
    $('busca').addEventListener('input', render);
    main();
  </script>
</body>
</html>
