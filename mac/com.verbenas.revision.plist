<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.verbenas.revision</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>/Users/atrujimar/Documents/WEBS/VerbenasTenerife/scripts/revision-auto.mjs</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/atrujimar/Documents/WEBS/VerbenasTenerife</string>
  <!-- Al iniciar sesión: si la última revisión tiene menos de 20h, el propio
       script termina sin hacer nada (ver STAMP en scripts/revision-auto.mjs). -->
  <key>RunAtLoad</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/tmp/verbenas-revision.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/verbenas-revision.log</string>
</dict>
</plist>
